{
  "name": "dsh-bibibobo",
  "version": "0.1.0",
  "description": "Reads DeepSeek Harness replies aloud with bibibobo's sawtooth speech synth, with pause and stop.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/DETAIL.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node test/synth.test.mjs",
    "prepublishOnly": "node tools/build.mjs && node test/synth.test.mjs && node tools/pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "bibibobo",
    "speech",
    "tts",
    "voice",
    "audio"
  ],
  "license": "MIT",
  "author": "cxv117793-blip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxv117793-blip/dsh-bibibobo.git"
  },
  "homepage": "https://github.com/cxv117793-blip/dsh-bibibobo#readme",
  "bugs": {
    "url": "https://github.com/cxv117793-blip/dsh-bibibobo/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
